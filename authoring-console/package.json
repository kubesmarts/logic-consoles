{
  "name": "authoring-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoring Console for the Logic Operator (shell, typed contracts, mock fixtures).",
  "scripts": {
    "dev": "npm run build:launcher && node dist/launcher/index.js --dev",
    "dev:hosted": "vite",
    "build": "tsc -b && vite build && npm run build:launcher",
    "build:launcher": "tsc -p launcher/tsconfig.json",
    "build:sea": "node scripts/build-sea.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist/launcher/index.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.2",
    "@monaco-editor/react": "4.7.0",
    "@openworkflowspec/diagram-editor": "1.1.0",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-icons": "6.7.0",
    "@patternfly/react-table": "6.7.0",
    "@tanstack/react-query": "5.108.2",
    "@xyflow/react": "13.0.2",
    "ajv": "8.20.0",
    "monaco-editor": "0.54.0",
    "monaco-yaml": "5.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "msw": "3.0.7",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  }
}
